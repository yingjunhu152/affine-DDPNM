<?xml version="1.0"?>
<!DOCTYPE Xdmf SYSTEM "Xdmf.dtd" []>
<Xdmf Version="3.0" xmlns:xi="https://www.w3.org/2001/XInclude">
  <Domain>
    <Grid Name="mesh" GridType="Uniform">
      <Topology TopologyType="Triangle" NumberOfElements="532" NodesPerElement="3">
        <DataItem Dimensions="532 3" NumberType="Int" Format="HDF">ddpnm_2d_fields.h5:/Mesh/mesh/topology</DataItem>
      </Topology>
      <Geometry GeometryType="XY">
        <DataItem Dimensions="334 2" Format="HDF">ddpnm_2d_fields.h5:/Mesh/mesh/geometry</DataItem>
      </Geometry>
    </Grid>
    <Grid Name="u_ddpnm" GridType="Collection" CollectionType="Temporal">
      <Grid Name="u_ddpnm" GridType="Uniform">
        <xi:include xpointer="xpointer(/Xdmf/Domain/Grid[@GridType='Uniform'][1]/*[self::Topology or self::Geometry])" />
        <Time Value="0" />
        <Attribute Name="u_ddpnm" AttributeType="Vector" Center="Node">
          <DataItem Dimensions="334 3" Format="HDF">ddpnm_2d_fields.h5:/Function/u_ddpnm/0</DataItem>
        </Attribute>
      </Grid>
    </Grid>
    <Grid Name="p_ddpnm" GridType="Collection" CollectionType="Temporal">
      <Grid Name="p_ddpnm" GridType="Uniform">
        <xi:include xpointer="xpointer(/Xdmf/Domain/Grid[@GridType='Uniform'][1]/*[self::Topology or self::Geometry])" />
        <Time Value="0" />
        <Attribute Name="p_ddpnm" AttributeType="Scalar" Center="Node">
          <DataItem Dimensions="334 1" Format="HDF">ddpnm_2d_fields.h5:/Function/p_ddpnm/0</DataItem>
        </Attribute>
      </Grid>
    </Grid>
    <Grid Name="u_reference" GridType="Collection" CollectionType="Temporal">
      <Grid Name="u_reference" GridType="Uniform">
        <xi:include xpointer="xpointer(/Xdmf/Domain/Grid[@GridType='Uniform'][1]/*[self::Topology or self::Geometry])" />
        <Time Value="0" />
        <Attribute Name="u_reference" AttributeType="Vector" Center="Node">
          <DataItem Dimensions="334 3" Format="HDF">ddpnm_2d_fields.h5:/Function/u_reference/0</DataItem>
        </Attribute>
      </Grid>
    </Grid>
    <Grid Name="p_reference" GridType="Collection" CollectionType="Temporal">
      <Grid Name="p_reference" GridType="Uniform">
        <xi:include xpointer="xpointer(/Xdmf/Domain/Grid[@GridType='Uniform'][1]/*[self::Topology or self::Geometry])" />
        <Time Value="0" />
        <Attribute Name="p_reference" AttributeType="Scalar" Center="Node">
          <DataItem Dimensions="334 1" Format="HDF">ddpnm_2d_fields.h5:/Function/p_reference/0</DataItem>
        </Attribute>
      </Grid>
    </Grid>
  </Domain>
</Xdmf>
